{
  "name": "PublishAuditLog",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Reference to ScheduledPost"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "scheduled",
        "publish_started",
        "publish_succeeded",
        "publish_failed",
        "retry_attempted",
        "cancelled"
      ],
      "description": "Action type"
    },
    "actor_email": {
      "type": "string",
      "description": "User who performed the action"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (error details, retry count, etc.)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When action occurred"
    }
  },
  "required": [
    "post_id",
    "action"
  ]
}